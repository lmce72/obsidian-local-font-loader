{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],

    // Bun strips types without checking them; this config exists for `bun run typecheck`, so it
    // type-checks but never emits.
    "noEmit": true,

    // obsidian.d.ts pulls in CodeMirror's types, which are large and not ours to fix.
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // The plugin is loaded as a CommonJS bundle, but the sources are written as ES modules and
    // bun rewrites the format on the way out.
    "verbatimModuleSyntax": false,

    // `require` is used deliberately in two places: Obsidian's `require('obsidian')` shim, and
    // `require('os')` for the desktop hostname (guarded, and absent on mobile).
    "types": ["node", "obsidian"],

    // The sources began as untyped JavaScript and were annotated file by file until the whole
    // tree passed here with strict on; keep it on. `useUnknownInCatchVariables` stays off because
    // the catch blocks hand their error straight to _logError, which already takes `unknown`.
    "strict": true,
    "useUnknownInCatchVariables": false
  },
  "include": ["src/**/*.ts"]
}
