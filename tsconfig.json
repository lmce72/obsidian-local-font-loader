{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],

    // Bun strips types without checking them; this config exists for `bun run typecheck`, so it
    // type-checks but never emits.
    "noEmit": true,

    // obsidian.d.ts pulls in CodeMirror's types, which are large and not ours to fix.
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // The plugin is loaded as a CommonJS bundle, but the sources are written as ES modules and
    // bun rewrites the format on the way out.
    "verbatimModuleSyntax": false,

    // `require` is used deliberately in two places: Obsidian's `require('obsidian')` shim, and
    // `require('os')` for the desktop hostname (guarded, and absent on mobile).
    "types": ["node", "obsidian"],

    // The sources began as untyped JavaScript. The data model in types.ts is fully typed and
    // checked; the surrounding UI code is being tightened incrementally, so the implicit-any and
    // strict-null families stay off until each file is annotated. Turning them on now would bury
    // the real errors under hundreds of annotations that carry no information yet.
    "strict": false,
    "useUnknownInCatchVariables": false
  },
  "include": ["src/**/*.ts"]
}
